<?xml version="1.0"?>
<!--
  slam_gmapping_offline: processes ROS 1 bag files directly (no rosbag play,
  no /clock), as fast as possible, and optionally logs the estimated
  trajectory of base_frame in TUM format.

  Examples:
    roslaunch gmapping slam_gmapping_offline.launch bags:=/abs/path/run.bag

    roslaunch gmapping slam_gmapping_offline.launch \
      bags:="/abs/path/run_0.bag /abs/path/run_1.bag" \
      scan_topic:=/front/scan start:=10 duration:=120 \
      log:=/abs/path/results/run.txt seed:=42

    Batch run (node exits when done and takes roslaunch down with it):
    roslaunch gmapping slam_gmapping_offline.launch bags:=/abs/path/run.bag \
      log:=/abs/path/results/run.txt spin:=false required:=true

  Relative paths in 'bags' and 'log' are resolved against the node's working
  directory, which under roslaunch is ROS_HOME (default: ~/.ros). Use
  absolute paths. Paths with spaces are not supported.
-->
<launch>

  <!-- Offline (command line) options of the node -->
  <arg name="bags"
       doc="Bag file(s), space-separated (absolute paths). Required." />
  <arg name="scan_topic" default="/scan"
       doc="LaserScan topic as recorded in the bags (exact string match)" />
  <arg name="start" default="0.0"
       doc="Start this many seconds after the first message of the bags" />
  <arg name="duration" default="0.0"
       doc="Process only this many seconds after start (0 or less: to the end)" />
  <arg name="log" default=""
       doc="Base file name of the TUM logs (empty: logging disabled)" />
  <arg name="seed" default="0"
       doc="GMapping RNG seed (0: seed from the current time)" />
  <arg name="spin" default="true"
       doc="Keep the node alive after processing (map_saver, rviz)" />

  <!-- Launch options -->
  <arg name="params_file" default="$(find gmapping)/config/slam_gmapping.yaml"
       doc="YAML with the GMapping parameters (loaded into ~)" />
  <arg name="node_name" default="slam_gmapping_offline"
       doc="Node name (also the private parameter namespace)" />
  <arg name="required" default="false"
       doc="Shut down the whole launch when the node exits (use with spin:=false)" />
  <arg name="rviz" default="false"
       doc="Start rviz with gmapping/rviz/rviz.rviz" />
  <arg name="debug" default="false"
       doc="Use gmapping/config/rosconsole.config (DEBUG log level)" />
  <arg name="launch_prefix" default=""
       doc="e.g. 'xterm -e gdb --args' (build with Debug or RelWithDebInfo)" />

  <!-- Command line of the node; optional flags are only added when set.
       ($(eval) must span the whole attribute, hence arg('...') inside.) -->
  <arg name="node_args" value="$(eval
    '-b ' + arg('bags') +
    ' --scantopic ' + arg('scan_topic') +
    ' --start ' + str(arg('start')) +
    (' --duration ' + str(arg('duration')) if float(arg('duration')) > 0 else '') +
    (' --log ' + arg('log') if arg('log') != '' else '') +
    ' --seed ' + str(arg('seed')) +
    ' --spin ' + str(arg('spin')).lower())" />

  <!-- Do NOT set /use_sim_time: the node reads the bags itself and nothing
       publishes /clock (ros::Time::now() would stay at 0). -->

  <node pkg="gmapping" type="slam_gmapping_offline" name="$(arg node_name)"
        output="screen" clear_params="true" required="$(arg required)"
        args="$(arg node_args)" launch-prefix="$(arg launch_prefix)">

    <env if="$(arg debug)" name="ROSCONSOLE_CONFIG_FILE"
         value="$(find gmapping)/config/rosconsole.config" />

    <rosparam command="load" file="$(arg params_file)" />

    <!-- Per-launch overrides go after the rosparam load, e.g.: -->
    <!-- <param name="map_update_interval" value="-1.0" /> -->

  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find gmapping)/rviz/rviz.rviz" />

</launch>
