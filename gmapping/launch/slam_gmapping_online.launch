<?xml version="1.0"?>
<!--
  slam_gmapping_online: live 2D SLAM (sensor_msgs/LaserScan + odometry in TF)

  Examples:
    roslaunch gmapping slam_gmapping_online.launch
    roslaunch gmapping slam_gmapping_online.launch scan_topic:=/front/scan rviz:=true
    roslaunch gmapping slam_gmapping_online.launch params_file:=/abs/path/my_robot.yaml

  With a bag file as input, set use_sim_time:=true and play the bag with the
  clock option (rosbag play, see README).
-->
<launch>

  <arg name="scan_topic" default="scan"
       doc="LaserScan topic remapped onto the node's 'scan' input" />
  <arg name="params_file" default="$(find gmapping)/config/slam_gmapping.yaml"
       doc="YAML with the GMapping parameters (loaded into ~)" />
  <arg name="node_name" default="slam_gmapping_online"
       doc="Node name (also the private parameter namespace)" />
  <arg name="use_sim_time" default="false"
       doc="Set /use_sim_time to true (needed when replaying bags)" />
  <arg name="rviz" default="false"
       doc="Start rviz with gmapping/rviz/rviz.rviz" />
  <arg name="debug" default="false"
       doc="Use gmapping/config/rosconsole.config (DEBUG log level)" />
  <arg name="launch_prefix" default=""
       doc="e.g. 'xterm -e gdb --args' (build with Debug or RelWithDebInfo)" />

  <param if="$(arg use_sim_time)" name="use_sim_time" value="true" />

  <node pkg="gmapping" type="slam_gmapping_online" name="$(arg node_name)"
        output="screen" clear_params="true"
        launch-prefix="$(arg launch_prefix)">

    <env if="$(arg debug)" name="ROSCONSOLE_CONFIG_FILE"
         value="$(find gmapping)/config/rosconsole.config" />

    <remap from="scan" to="$(arg scan_topic)" />

    <rosparam command="load" file="$(arg params_file)" />

    <!-- Per-launch overrides go after the rosparam load, e.g.: -->
    <!-- <param name="particles" value="50" /> -->

  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find gmapping)/rviz/rviz.rviz" />

</launch>
